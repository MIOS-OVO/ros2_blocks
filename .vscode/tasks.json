{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ROS 2: Build",
      "type": "shell",
      "command": "source /opt/ros/humble/setup.bash && colcon build --symlink-install",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "ROS 2: Launch detection and Foxglove",
      "type": "shell",
      "command": "source /opt/ros/humble/setup.bash && source install/local_setup.bash && ros2 run recognized_blocks bringup",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "ROS 2: Select block color",
      "type": "shell",
      "command": "source /opt/ros/humble/setup.bash && source install/local_setup.bash && ros2 run recognized_blocks select_color",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "problemMatcher": []
    }
  ]
}
